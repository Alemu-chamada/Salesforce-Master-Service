# ---------- App ----------
APP_ENV=dev
LOG_LEVEL=INFO
APP_NAME=salesforce-master-service
API_PREFIX=/api
DEBUG=true

# ---------- Database ----------
DATABASE_URL=postgresql+psycopg2://sf_master:sf_master_pass@localhost:5432/sf_master
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# ---------- Salesforce API ----------
SF_LOGIN_URL=https://test.salesforce.com
SF_CLIENT_ID=REPLACE_ME_CONNECTED_APP_CONSUMER_KEY
SF_CLIENT_SECRET=REPLACE_ME_CONNECTED_APP_CONSUMER_SECRET
SF_JWT_PRIVATE_KEY_PATH=
SF_API_VERSION=59.0
SF_TIMEOUT_SECONDS=60

# ---------- Bulk API ----------
SF_BULK_POLL_INTERVAL_SECONDS=10
SF_BULK_MAX_WAIT_MINUTES=120
SF_BULK_SUPPORTED_OBJECTS=Account,Contact,Opportunity,OpportunityLineItem,Lead,Case,Task,Event,Campaign,User

# ---------- MinIO ----------
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=salesforce-data
MINIO_SECURE=false

# ---------- Resilience ----------
EXTERNAL_CALL_MAX_RETRIES=3
EXTERNAL_CALL_RETRY_DELAYS=1,2,4
EXTERNAL_CALL_MAX_DELAY_SECONDS=30
EXTERNAL_CALL_JITTER=true
DLQ_PAYLOAD_MAX_BYTES=65536

# ---------- HMAC ----------
HMAC_ENABLED=true
HMAC_SECRET_KEY_CORE=REPLACE_ME_COORDINATOR_SHARED_SECRET
HMAC_SECRET_KEY_ENGINEER=REPLACE_ME_ENGINEER_READONLY_SECRET
HMAC_SIGNATURE_MAX_AGE=300
HMAC_CLIENT_CONFIG='{"coordinator":{"role":"full"},"engineer":{"role":"read_only"}}'

# ---------- Health ----------
HEALTH_CHECK_DB_ENABLED=true
HEALTH_CHECK_MINIO_ENABLED=true

# ---------- Data Storage ----------
DATA_ROOT_DIR=./data/scans
